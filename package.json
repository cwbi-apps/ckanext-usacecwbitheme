{
  "name": "ckanext-cwbi-theme-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.css -o ckanext/cwbi_theme/assets/cwbi-theme.css",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i tailwind.css -o ckanext/cwbi_theme/assets/cwbi-theme.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "tailwindcss": "^3.4.0"
  }
}
